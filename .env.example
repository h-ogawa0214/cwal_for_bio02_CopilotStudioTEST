# Required
# プロジェクトフォルダ自体がOneDrive配下にあるため、既定パスのままでOneDrive同期対象になる
EXCEL_FILE_PATH=data/releases.xlsx

# 掲載可否・タイトル/リード編集はAPIを呼ばず、Claude Codeが
# --dump-for-review / --apply-review の間で直接判定するため、
# LLM APIキーは不要（OPENAI_API_KEY等は使用しません）

# Optional tuning
LOOKBACK_DAYS=14
TDNET_LOOKBACK_DAYS=3
MAX_ITEMS_PER_COMPANY=30
REQUEST_TIMEOUT_SECONDS=30
USER_AGENT=PRDisclosureCurator/1.0 (+https://github.com/your-org/pr-disclosure-curator)
DRY_RUN=false
SHADOW_DEFAULT=false
